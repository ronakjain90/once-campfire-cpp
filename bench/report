#!/usr/bin/env python3
"""Print a Markdown table from a bench/run results dir.

  bench/report DIR

For each route, concurrency and app: median [min-max] across reps of req/s, p50 and p99 latency
(ms) and app CPU ms per request (cgroup usage_usec during the measured cell / requests).
"""
import glob, json, os, statistics, sys

out = sys.argv[1]
runs = {}
for f in sorted(glob.glob(os.path.join(out, "*-*.json"))):
    r = json.load(open(f))
    runs.setdefault(r["app"], []).append(r)
if not runs:
    sys.exit(f"no results in {out}")


def cell(vals):
    vals = [v for v in vals if v is not None]
    if not vals:
        return "-"
    m = statistics.median(vals)
    fmt = (lambda v: f"{v:,.0f}") if m >= 100 else (lambda v: f"{v:.1f}") if m >= 10 else (lambda v: f"{v:.2f}") if m >= 0.1 else (lambda v: f"{v:.3f}")
    return fmt(m) + (f" [{fmt(min(vals))}-{fmt(max(vals))}]" if len(vals) > 1 else "")


def metric(h, key):
    if key == "rps":
        return h["rps"]
    if key == "cpu":
        return h["app_cpu_usec"] / 1000 / h["requests"] if h["requests"] else None
    return h["latency"].get(key)


cells = {}  # (route, conc) -> app -> list of http cells
order = []
for app, rs in runs.items():
    for r in rs:
        for h in r["http"]:
            k = (h["route"], h["conc"])
            if k not in order:
                order.append(k)
            cells.setdefault(k, {}).setdefault(app, []).append(h)

apps = list(runs)
print(f"Median [min-max] over {', '.join(f'{a}: {len(runs[a])} rep(s)' for a in apps)}.\n")
print("| route | conc | app | req/s | p50 ms | p99 ms | app CPU ms/req |")
print("|---|---:|---|---:|---:|---:|---:|")
for k in order:
    for app in apps:
        hs = cells[k].get(app, [])
        print(f"| {k[0]} | {k[1]} | {app} | " + " | ".join(cell([metric(h, m) for h in hs]) for m in ("rps", "p50_ms", "p99_ms", "cpu")) + " |")

print("\nErrors and non-2xx/3xx responses:")
for app in apps:
    bad = [f"{h['route']} c={h['conc']} rep {r['rep']}: {h['statuses']} errors={h['errors']}"
           for r in runs[app] for h in r["http"] if h["errors"] or any(int(s) >= 400 for s in h["statuses"])]
    print(f"- {app}: " + ("; ".join(bad) if bad else "none"))
print("\nAverage response bytes (first rep): " + "; ".join(
    f"{app} {h['route']} c={h['conc']}: {h['avg_bytes']}" for app in apps for h in runs[app][0]["http"] if h["conc"] == min(x["conc"] for x in runs[app][0]["http"])))

cable = {}  # clients -> app -> list of cable results
for app, rs in runs.items():
    for r in rs:
        for c in r.get("cable", []):
            cable.setdefault(c["clients"], {}).setdefault(app, []).append(c)
if cable:
    print("\nAction Cable fan-out (one post reaches every client):\n")
    print("| clients | app | ready | deliveries/s | post-to-all p50 ms | post-to-all p99 ms | complete / posted |")
    print("|---:|---|---:|---:|---:|---:|---|")
    for n in sorted(cable):
        for app in apps:
            cs = cable[n].get(app, [])
            if not cs:
                continue
            done = ", ".join(f"{c['throughput']['complete']}/{c['throughput']['posted']}" for c in cs)
            print(f"| {n} | {app} | " + " | ".join([
                cell([c["ready"] for c in cs]),
                cell([c["throughput"]["delivered_msgs_per_sec"] for c in cs]),
                cell([c["latency"]["all_clients"].get("p50_ms") for c in cs]),
                cell([c["latency"]["all_clients"].get("p99_ms") for c in cs]),
                done]) + " |")
