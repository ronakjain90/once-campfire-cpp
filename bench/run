#!/usr/bin/env bash
# Benchmark app images with the Rust load generator, in the Colima VM.
#
#   bench/run [--apps name=image,name=image] [--reps 3] [--routes room_show,post_message]
#                  [--secs 8] [--concs "1 16 64"] [--cable "100 1000"] [--out DIR] [--rebuild]
#
# On the host, this script starts the runner container (campfire-bench-runner) and runs itself
# inside it. Inside the runner it does the work for each rep and each app (the order of the apps
# alternates between reps): copy the seed to /var/lib/campfire-bench, neuter deliveries, start the
# app on CPUs 0-3, wait for /up, sign in, run the load generator on CPUs 4-7, and read the app
# CPU time from the container cgroup. See README.md.
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# The folder that holds this repo and once-campfire-rust.
WORKSPACE=${CAMPFIRE_WORKSPACE:-$(cd "$HERE/../.." && pwd)}
RUNNER_IMAGE=campfire-bench-runner
BENCH_DIR=/var/lib/campfire-bench

if [ "${CAMPFIRE_BENCH_INNER:-}" != 1 ]; then
  # ---------------------------------------------------------------- host side (bash 3.2 safe)
  rebuild=0; args=(); prev=
  for a in "$@"; do
    if [ "$a" = --rebuild ]; then rebuild=1; continue; fi
    if [ "$prev" = --out ]; then case "$a" in /*) ;; *) a=$PWD/$a ;; esac; fi   # absolute for the runner
    args+=("$a"); prev=$a
  done
  if [ "$rebuild" = 1 ] || ! docker image inspect "$RUNNER_IMAGE" >/dev/null 2>&1; then
    docker build -t "$RUNNER_IMAGE" -f "$HERE/Dockerfile" "$WORKSPACE/once-campfire-rust/bench/loadgen" >&2
  fi
  exec docker run --rm --name "campfire-bench-runner-$$" --network host --pid host --cgroupns host \
    -e CAMPFIRE_BENCH_INNER=1 -e "HOST_UID=$(id -u)" -e "HOST_GID=$(id -g)" \
    -e PORT -e SERVER_CPUS -e LOADGEN_CPUS -e BENCH_APP_ENV -e BENCH_SECCOMP_UNCONFINED \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$WORKSPACE:$WORKSPACE" -v "$BENCH_DIR:$BENCH_DIR" -v /sys/fs/cgroup:/sys/fs/cgroup:ro \
    "$RUNNER_IMAGE" bash "$HERE/run" ${args[@]+"${args[@]}"}
fi

# ------------------------------------------------------------------ runner side (Debian bash)
SEED=$WORKSPACE/once-campfire-rust/parity/.seed/default
LABELS=$SEED/labels.json
ENV_FILE=$WORKSPACE/once-campfire-rust/parity/.env.reference

SERVER_CPUS=${SERVER_CPUS:-0-3}
LOADGEN_CPUS=${LOADGEN_CPUS:-4-7}
PORT=${PORT:-4390}
BASE=http://127.0.0.1:$PORT
APP_USER=1000:1000   # the user the app images declare

APPS=rust=campfire-rust:app REPS=3 ROUTES=room_show,post_message SECS=8 CONCS="1 16 64" CABLE="" OUT=""
CABLE_TPUT_SECS=${CABLE_TPUT_SECS:-15}
CABLE_POSTERS=${CABLE_POSTERS:-4}
while [ $# -gt 0 ]; do
  case "$1" in
    --apps) APPS=$2; shift 2 ;;
    --reps) REPS=$2; shift 2 ;;
    --routes) ROUTES=$2; shift 2 ;;
    --secs) SECS=$2; shift 2 ;;
    --concs) CONCS=${2//,/ }; shift 2 ;;
    --cable) CABLE=${2//,/ }; shift 2 ;;
    --out) OUT=$2; shift 2 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
OUT=${OUT:-$HERE/results/$(date +%Y%m%d-%H%M%S)}
mkdir -p "$OUT"
CONTAINER=campfire-bench-app-$PORT

log() { echo "[$(date +%T)] $*" >&2; }
label() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$LABELS" "$1"; }
lg() { taskset -c "$LOADGEN_CPUS" loadgen "$@"; }
jget() { python3 -c 'import json,sys; print(json.loads(sys.argv[1])[sys.argv[2]] or "")' "$1" "$2"; }

teardown() { docker rm -f "$CONTAINER" >/dev/null 2>&1 || true; }
trap teardown EXIT INT TERM

ROOM=$(label rooms.watercooler)
WRITE_ROOM=$(label rooms.hq)
BEFORE=$(label messages.busy_060)
AVATAR=$(label avatar_tokens.jason)
EMAIL=$(label emails.david)
PASSWORD=$(label passwords.all)

# Route table: name|path ("POST" for post_message). Same as once-campfire-rust/bench/run.
route_path() {
  case "$1" in
    room_show) echo "/rooms/$ROOM" ;;
    messages_page) echo "/rooms/$ROOM/messages?before=$BEFORE" ;;
    sidebar) echo "/users/me/sidebar" ;;
    search) echo "/searches?q=coffee" ;;
    avatar) echo "/users/$AVATAR/avatar" ;;
    static_css) echo "$CSS" ;;
    up) echo "/up" ;;
    post_message) echo POST ;;
    *) echo "unknown route $1" >&2; return 1 ;;
  esac
}

# Same environment as once-campfire-rust/bench/run env_args, for the Rust app.
env_args() {
  local ncpu workers
  ncpu=$(taskset -c "$SERVER_CPUS" nproc)
  workers=$(( (ncpu * 666 + 999) / 1000 ))
  grep -Ev '^(#|$|WEB_CONCURRENCY|JOB_CONCURRENCY|RAILS_MAX_THREADS|RAILS_LOG_LEVEL)' "$ENV_FILE" | sed 's/^/-e\n/'
  printf '%s\n' -e "WEB_CONCURRENCY=$workers" -e "JOB_CONCURRENCY=$workers" -e RAILS_MAX_THREADS=5 -e RAILS_LOG_LEVEL=warn
}

# Push and webhook deliveries go to a closed local port (as in bench/run).
neuter_deliveries() {
  python3 - "$1" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
db.execute("UPDATE push_subscriptions SET endpoint = 'https://127.0.0.1:9/push/' || id")
db.execute("UPDATE webhooks SET url = 'http://127.0.0.1:9/hook/' || id")
db.commit()
PY
}

cgroup_dir() {
  local id d; id=$(docker inspect -f '{{.Id}}' "$CONTAINER")
  for d in "/sys/fs/cgroup/system.slice/docker-$id.scope" "/sys/fs/cgroup/docker/$id"; do
    [ -f "$d/cpu.stat" ] && { echo "$d"; return; }
  done
  echo "no cgroup for $CONTAINER" >&2; return 1
}
cpu_usec() { awk '$1=="usage_usec"{print $2}' "$1/cpu.stat"; }

start_app() {
  local image=$1 dir=$2
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  mkdir -p "$dir/db" "$dir/storage"
  cp -a --reflink=auto "$SEED/db/." "$dir/db/"; cp -a --reflink=auto "$SEED/storage/." "$dir/storage/"
  neuter_deliveries "$dir/db/production.sqlite3"
  chown -R "$APP_USER" "$dir"
  local args=(); mapfile -t args < <(env_args)
  # BENCH_APP_ENV="NAME=value;NAME=value": more environment for the app (options of a sanitizer image).
  local kv app_env=${BENCH_APP_ENV:-}
  for kv in ${app_env//;/ }; do args+=(-e "$kv"); done
  sync
  # BENCH_SECCOMP_UNCONFINED=1: a TSan image needs the personality system call.
  docker run -d --name "$CONTAINER" --cpuset-cpus "$SERVER_CPUS" --user "$APP_USER" --network host \
    ${BENCH_SECCOMP_UNCONFINED:+--security-opt seccomp=unconfined} \
    -e "HTTP_PORT=$PORT" -e "TARGET_PORT=$((PORT + 1))" "${args[@]}" \
    -v "$dir/db:/rails/storage/db" -v "$dir/storage:/rails/storage/files" "$image" >/dev/null
  local i
  for i in $(seq 1 3000); do
    curl -fsS -o /dev/null "$BASE/up" 2>/dev/null && return 0
    sleep 0.02
  done
  docker logs "$CONTAINER" 2>&1 | tail -30 >&2
  return 1
}

run_rep() {
  local app=$1 image=$2 rep=$3
  local f=$OUT/$app-$rep.json
  local dir=$BENCH_DIR/$app-$rep-$$
  log "$app rep $rep: starting ($image)"
  start_app "$image" "$dir"
  local cg; cg=$(cgroup_dir)
  {
    echo "app $app rep $rep"
    echo "db dir: $dir/db"
    echo "db fs: $(stat -f -c '%T' "$dir/db")"
    echo "app: $(docker exec "$CONTAINER" grep Cpus_allowed_list /proc/1/status 2>&1 || grep Cpus_allowed_list "/proc/$(docker inspect -f '{{.State.Pid}}' "$CONTAINER")/status")"
  } >> "$OUT/pin.log"

  local cookie scrape csrf css streams
  cookie=$(jget "$(lg login --base "$BASE" --email "$EMAIL" --password "$PASSWORD")" cookie)
  scrape=$(lg scrape --base "$BASE" --cookie "$cookie" --room "$ROOM")
  csrf=$(jget "$scrape" csrf)
  CSS=$(jget "$scrape" css)
  streams=$(python3 -c 'import json,sys; print(",".join(json.loads(sys.argv[1])["streams"]))' "$scrape")

  local http_json="[]" name path args res c lgpid lgproc cpu0 cpu1 first=1
  for name in ${ROUTES//,/ }; do
    path=$(route_path "$name")
    if [ "$path" = POST ]; then args=(--post-room "$WRITE_ROOM" --csrf "$csrf"); else args=(--path "$path"); fi
    lg http --base "$BASE" --cookie "$cookie" "${args[@]}" --conc 4 --duration 2 >/dev/null
    for c in $CONCS; do
      cpu0=$(cpu_usec "$cg")
      lg http --base "$BASE" --cookie "$cookie" "${args[@]}" --conc "$c" --duration "$SECS" > "$OUT/.res" &
      lgpid=$!
      if [ "$first" = 1 ]; then
        sleep 1
        # $lgpid is a subshell; the load generator (taskset execs it) is its child.
        lgproc=$(pgrep -x -P "$lgpid" loadgen | head -1)
        echo "loadgen: $(grep Cpus_allowed_list "/proc/$lgproc/status") (pid $lgproc, $(tr '\0' ' ' < "/proc/$lgproc/cmdline" | cut -c1-60))" >> "$OUT/pin.log"
        first=0
      fi
      wait "$lgpid"
      cpu1=$(cpu_usec "$cg")
      res=$(cat "$OUT/.res")
      http_json=$(python3 -c '
import json,sys
a=json.loads(sys.argv[1]); r=json.loads(sys.argv[2])
r["route"]=sys.argv[3]; r["app_cpu_usec"]=int(sys.argv[4])-int(sys.argv[5])
r["requests"]=sum(r["statuses"].values())+r["errors"]
a.append(r); print(json.dumps(a))' "$http_json" "$res" "$name" "$cpu1" "$cpu0")
      log "$app rep $rep: $name c=$c $(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); print(r["rps"], "rps p50", r["latency"].get("p50_ms"), "p99", r["latency"].get("p99_ms"), r["statuses"], "err", r["errors"], "avg_bytes", r["avg_bytes"])' "$res")"
    done
  done

  # The Action Cable fan-out: the same command and arguments as once-campfire-rust/bench/run.
  local cable_json="[]" n
  for n in $CABLE; do
    cpu0=$(cpu_usec "$cg")
    res=$(lg cable --base "$BASE" --cookie "$cookie" --room "$ROOM" --csrf "$csrf" --streams "$streams" \
      --clients "$n" --tput-secs "$CABLE_TPUT_SECS" --posters "$CABLE_POSTERS")
    cpu1=$(cpu_usec "$cg")
    cable_json=$(python3 -c '
import json,sys
a=json.loads(sys.argv[1]); r=json.loads(sys.argv[2]); r["app_cpu_usec"]=int(sys.argv[3])-int(sys.argv[4])
a.append(r); print(json.dumps(a))' "$cable_json" "$res" "$cpu1" "$cpu0")
    log "$app rep $rep: cable $n clients $(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); print("ready", r["ready"], "lat all p50", r["latency"]["all_clients"].get("p50_ms"), "p99", r["latency"]["all_clients"].get("p99_ms"), "tput", r["throughput"]["delivered_msgs_per_sec"], "msg/s", r["throughput"]["complete"], "/", r["throughput"]["posted"])' "$res")"
    sleep 2
  done

  python3 - "$f" "$app" "$image" "$rep" "$http_json" "$cable_json" <<'PY'
import json, sys
f, app, image, rep, http, cable = sys.argv[1:]
json.dump({"app": app, "image": image, "rep": int(rep), "http": json.loads(http), "cable": json.loads(cable)},
          open(f, "w"), indent=1)
PY
  # The log of the app has the reports of a sanitizer image.
  docker logs "$CONTAINER" > "$OUT/$app-$rep.applog" 2>&1 || true
  docker rm -f "$CONTAINER" >/dev/null
  rm -rf "$dir"
  log "$app rep $rep: done -> $f"
}

{
  echo "date: $(date -Is)"
  echo "kernel: $(uname -r), $(nproc) cpus; server cpus $SERVER_CPUS, loadgen cpus $LOADGEN_CPUS"
  echo "routes: $ROUTES; secs: $SECS; concs: $CONCS; cable clients: ${CABLE:-none}; reps: $REPS"
  for pair in ${APPS//,/ }; do echo "${pair%%=*}: ${pair#*=} $(docker image inspect -f '{{.Id}}' "${pair#*=}")"; done
} | tee "$OUT/env.txt" >&2
: > "$OUT/pin.log"

ORDER=(${APPS//,/ })
for rep in $(seq 1 "$REPS"); do
  apps=("${ORDER[@]}")
  if [ $((rep % 2)) -eq 0 ]; then apps=(); for ((i = ${#ORDER[@]} - 1; i >= 0; i--)); do apps+=("${ORDER[$i]}"); done; fi
  for pair in "${apps[@]}"; do run_rep "${pair%%=*}" "${pair#*=}" "$rep"; done
done
rm -f "$OUT/.res"
"$HERE/report" "$OUT" | tee "$OUT/report.md"
chown -R "$HOST_UID:$HOST_GID" "$OUT" 2>/dev/null || true
