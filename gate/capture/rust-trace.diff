@@ -422,9 +423,43 @@ fn open_connection(path: &Path, reader: bool) -> Result<Connection> {
     if reader {
         conn.pragma_update(None, "query_only", true)?;
     }
+    if std::env::var_os("CAMPFIRE_SQL_TRACE").is_some() {
+        let events = TraceEventCodes::SQLITE_TRACE_STMT | TraceEventCodes::SQLITE_TRACE_PROFILE | TraceEventCodes::SQLITE_TRACE_ROW;
+        conn.trace_v2(events, Some(if reader { trace_reader } else { trace_writer }));
+    }
     Ok(conn)
 }
 
+thread_local! {
+    /// Rows the statements running on this thread have returned since the last one finished.
+    static TRACE_ROWS: Cell<u64> = const { Cell::new(0) };
+}
+
+/// `CAMPFIRE_SQL_TRACE`: to stderr, a `start` line with the expanded SQL (bound values filled in)
+/// when a statement runs, and an `end` line with its row count when it finishes.
+fn trace_statement(role: &str, event: TraceEvent<'_>) {
+    let thread = std::thread::current().id();
+    match event {
+        TraceEvent::Stmt(stmt, sql) => {
+            let sql = stmt.expanded_sql().unwrap_or_else(|| sql.to_string());
+            eprintln!("SQLTRACE start {role} {thread:?} {}", sql.replace('\n', "\\n"));
+        }
+        TraceEvent::Row(_) => TRACE_ROWS.set(TRACE_ROWS.get() + 1),
+        TraceEvent::Profile(stmt, _) => {
+            eprintln!("SQLTRACE end {role} {thread:?} rows={} {}", TRACE_ROWS.replace(0), stmt.sql().replace('\n', "\\n"));
+        }
+        _ => {}
+    }
+}
+
+fn trace_reader(event: TraceEvent<'_>) {
+    trace_statement("reader", event);
+}
+
+fn trace_writer(event: TraceEvent<'_>) {
+    trace_statement("writer", event);
+}
+
