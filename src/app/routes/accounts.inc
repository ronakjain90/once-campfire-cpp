POST   /account/users(.:format)  misc::action_not_found
GET    /account/users/new(.:format)  misc::action_not_found
GET    /account/users/:id/edit(.:format)  misc::action_not_found
GET    /account/users/:id(.:format)  misc::action_not_found
PATCH  /account/users/:id(.:format)  accounts_users::update
PUT    /account/users/:id(.:format)  accounts_users::update
DELETE /account/users/:id(.:format)  accounts_users::destroy
PATCH  /account/bots/:bot_id/key(.:format)  accounts_bots_keys::update
