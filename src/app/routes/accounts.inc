GET    /account/new(.:format)  misc::action_not_found
GET    /account/edit(.:format)  accounts::edit
GET    /account(.:format)  misc::action_not_found
PATCH  /account(.:format)  accounts::update
PUT    /account(.:format)  accounts::update
DELETE /account(.:format)  misc::action_not_found
POST   /account(.:format)  misc::action_not_found
