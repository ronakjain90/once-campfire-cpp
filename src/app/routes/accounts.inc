GET    /account/bots/new(.:format)  accounts_bots::new
GET    /account/bots/:id/edit(.:format)  accounts_bots::edit
GET    /account/bots/:id(.:format)  misc::action_not_found
PATCH  /account/bots/:id(.:format)  accounts_bots::update
