// The named routes of reference/config/routes.rb (Rust: crates/routes/src/lib.rs).
// CF_ROUTE(name, pattern, endpoint). `name` is the Rails helper name without `_path`. `pattern`
// has `:param` for each argument. `endpoint` is the Rails `controller#action` that the route
// recognizes. CF_ROUTE_ME is a route in `scope defaults: { user_id: "me" }`: the helper may leave
// out `user_id` (the first argument), and then `user_id` is "me". test/named_routes.json (made by
// the reference app) checks this list.
CF_ROUTE(root, "/", "welcome#show")
CF_ROUTE(new_first_run, "/first_run/new", "first_runs#new")
CF_ROUTE(edit_first_run, "/first_run/edit", "first_runs#edit")
