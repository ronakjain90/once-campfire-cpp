{# reference/app/views/accounts/_invite.html.erb #}
{% include views/helpers/accounts.hpp %}
{% include routes/routes.hpp %}
{% params const ViewContext& ctx, const std::string& url %}
<div class="flex flex-column align-center gap">

  <label class="flex flex-column gap full-width" style="--row-gap: 0.5em">
    <strong id="invite_label" class="invite-label">Share to invite more people</strong>
    <span class="flex align-center gap input input--actor fill-white">
      {% call image_tag(ctx, "person-add.svg", attrs().aria_hidden().size(20).cls("colorize--black")) %}
      <input type="text" class="input" id="invite_url" value="{{ url }}" aria-labelledby="invite_label" readonly>
    </span>
  </label>

  <div class="flex align-center gap">
    {% wrap link_to_zoom_qr_code(url) %}
      <span class="for-screen-reader">Show join link QR code</span>
      {% call image_tag(ctx, "qr-code.svg", attrs().aria_hidden().size(20).cls("colorize--black")) %}
    {% end %}

    {% wrap button_to_copy_to_clipboard(url) %}
      <span class="for-screen-reader">Copy join link</span>
      {% call image_tag(ctx, "copy-paste.svg", attrs().aria_hidden().size(20).cls("colorize--black")) %}
    {% end %}

    {% wrap web_share_session_button(url, "Link to join Campfire", "Hit this link to join me in Campfire and start chatting.") %}
      <span class="for-screen-reader">Share join link</span>
      {% call image_tag(ctx, "share.svg", attrs().aria_hidden().size(20).cls("colorize--black")) %}
    {% end %}

    {% if ctx.can_administer() %}
      {% wrap button_to(routes::account_join_code(), attrs().cls("btn btn--regenerate")) %}
        {% call image_tag(ctx, "refresh.svg", attrs().aria_hidden().size(20).cls("colorize--black")) %}
        <span class="for-screen-reader">Regenerate join link</span>
      {% end %}
    {% end %}
  </div>
</div>
