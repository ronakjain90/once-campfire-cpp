{# reference/app/views/accounts/bots/_bot.html.erb #}
{% include views/accounts/types.hpp %}
{% include views/helpers/accounts.hpp %}
{% include routes/routes.hpp %}
{% params const ViewContext& ctx, const BotView& bot %}
<li class="flex flex-column gap flush fill-shade border-radius pad-block pad-inline-double">
  <div class="flex align-center gap">
    <figure class="avatar flex-item--no-shrink" style="--avatar-size: 2.65em;">
      {% call avatar_tag(ctx, bot.user.id, bot.user.title, bot.user.avatar_path, attrs().attr("loading", "lazy")) %}
    </figure>

    <div class="min-width">
      <div class="overflow-ellipsis txt-large"><strong>{{ bot.user.name }}</strong></div>
    </div>

    {% wrap link_to(routes::edit_account_bot(bot.user.id), attrs().cls("btn flex-item-justify-end").style("view-transition-name: chat-bot-" + std::to_string(bot.user.id))) %}
      {% call image_tag(ctx, "pencil.svg", attrs().aria_hidden().size(20)) %}
      <span class="for-screen-reader">Edit {{ bot.user.name }}</span>
    {% end %}
  </div>

  {% for room : bot.rooms %}
    <fieldset class="gap max-width pad border border-radius">
      <legend class="min-width txt-align-start pad-inline">
        <strong class="overflow-ellipsis">{{ room.name }}</strong>
      </legend>

      <div class="flex align-center gap">
        {% call image_tag(ctx, "messages-outlined.svg", attrs().aria_hidden().size(24).cls("colorize--black")) %}

        <div class="flex-item-grow">
          <input type="text" class="input full-width fill-white" value="{{ curl_text_line(ctx.url(routes::room_bot_messages(room.id, bot.bot_key))) }}" aria-label="curl command for posting messages" readonly>
        </div>

        <div class="txt-small">
          {% wrap button_to_copy_to_clipboard(curl_text_line(ctx.url(routes::room_bot_messages(room.id, bot.bot_key)))) %}
            {% call image_tag(ctx, "copy-paste.svg", attrs().aria_hidden().size(20)) %}
            <span class="for-screen-reader">Copy message command</span>
          {% end %}
        </div>
      </div>

      <div class="flex align-center gap">
        {% call image_tag(ctx, "attachment.svg", attrs().aria_hidden().size(24).cls("colorize--black")) %}

        <div class="flex-item-grow">
          <input type="text" class="input full-width fill-white" value="{{ curl_upload_line(ctx.url(routes::room_bot_messages(room.id, bot.bot_key))) }}" aria-label="curl command for posting attachments" readonly>
        </div>

        <div class="txt-small">
          {% wrap button_to_copy_to_clipboard(curl_upload_line(ctx.url(routes::room_bot_messages(room.id, bot.bot_key)))) %}
            {% call image_tag(ctx, "copy-paste.svg", attrs().aria_hidden().size(20)) %}
            <span class="for-screen-reader">Copy attachment command</span>
          {% end %}
        </div>
      </div>
    </fieldset>
  {% end %}
</li>
