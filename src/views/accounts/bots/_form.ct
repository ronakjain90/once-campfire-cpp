{# reference/app/views/accounts/bots/_form.html.erb #}
{% include views/accounts/types.hpp %}
{% include views/helpers/accounts.hpp %}
{% include views/helpers/forms.hpp %}
{% include views/sessions/helpers.hpp %}
{% params const ViewContext& ctx, const BotFormView& bot, const helpers::FormWith& form %}
<h1 class="for-screen-reader">Chat Bot Setup</h1>
<label class="align-center center avatar__form gap" data-controller="upload-preview">
  <div class="btn input--file">
    {% call image_tag(ctx, "camera.svg", attrs().aria_hidden().size(20)) %}
    {% call form.file_field("avatar", attrs().cls("input").attr("accept", "image/*").data("upload_preview_target", "input").data("action", "upload-preview#previewImage")) %}
    <span class="for-screen-reader">Upload bot avatar</span>
  </div>

  <div class="avatar input--file txt-xx-large" style="--avatar-size: var(--btn-size);">
    {% call image_tag(ctx, bot.avatar_attachment_url.value_or("default-bot-avatar.svg"), attrs().alt("Bot avatar").size(48).data("upload_preview_target", "image")) %}
  </div>
</label>

<div class="flex align-center gap">
  {% call translation_button(ctx, "bot_name") %}
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    {% call form.text_field("name", bot.name ? std::optional<std::string_view>(*bot.name) : std::nullopt, attrs().cls("input").autocomplete("name").placeholder("Name the bot").autofocus().required(true).data("1p-ignore", true)) %}
    {% call image_tag(ctx, "bot.svg", attrs().aria_hidden().size(24).cls("colorize--black")) %}
  </label>
</div>

<div class="flex align-center gap">
  {% call translation_button(ctx, "webhook_url") %}
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    {% call form.url_field("webhook_url", bot.webhook_url ? std::optional<std::string_view>(*bot.webhook_url) : std::nullopt, attrs().cls("input").placeholder("Webhook URL")) %}
    {% call image_tag(ctx, "web.svg", attrs().aria_hidden().size(24).cls("colorize--black")) %}
  </label>
</div>

{% call profile_form_submit_button(ctx) %}
