{# reference/app/views/accounts/edit.html.erb: the content of the page. The title, the nav and the footer come from the controller. #}
{% include views/helpers/accounts.hpp %}
{% include views/helpers/forms.hpp %}
{% include views/sessions/helpers.hpp %}
{% include views/accounts/types.hpp %}
{% include routes/routes.hpp %}
{% params const ViewContext& ctx, const AccountEditView& view, const std::string& join_url, const helpers::FormWith& logo_form, const helpers::FormWith& image_form, const helpers::FormWith& name_form, const helpers::FormWith& settings_form, const helpers::FormWith& settings_fields %}
<section class="panel txt-align-center flex flex-column gap" style="view-transition-name: account-settings">
  {% if ctx.can_administer() %}
    <div class="align-center center avatar__form gap" data-controller="upload-preview">
      {% wrap form_with(logo_form) %}
        <label class="btn input--file">
          {% call image_tag(ctx, "camera.svg", attrs().aria_hidden().size(20)) %}
          {% call logo_form.file_field("logo", attrs().cls("input").attr("accept", "image/*").data("action", "upload-preview#previewImage change->form#submit")) %}
          <span class="for-screen-reader">Upload logo</span>
        </label>
      {% end %}

      {% wrap form_with(image_form) %}
        <label class="btn avatar input--file account-logo txt-xx-large">
          {% call image_tag(ctx, ctx.account.logo_url, attrs().role("presentation").size(48).data("upload_preview_target", "image")) %}
          {% call image_form.file_field("logo", attrs().cls("input").attr("accept", "image/*").data("action", "upload-preview#previewImage change->form#submit")) %}
          <span class="for-screen-reader">Upload logo</span>
        </label>
      {% end %}

      {% if ctx.account.has_logo %}
        {% wrap button_to(ctx.account.logo_url, attrs().method("delete").cls("btn btn--negative txt-small avatar__delete-btn")) %}
          {% call image_tag(ctx, "minus.svg", attrs().aria_hidden().size(20)) %}
          <span class="for-screen-reader">Delete logo</span>
        {% end %}
      {% end %}
    </div>

    {% wrap form_with(name_form) %}
      <div class="flex align-center gap">
        {% call translation_button(ctx, "account_name") %}

        <label class="flex align-center gap flex-item-grow">
          {% call name_form.text_field("name", std::optional<std::string_view>(ctx.account.name), attrs().cls("input txt-large").autocomplete("off").placeholder("Name this account").autofocus().data("action", "keydown.enter->form#submit")) %}
        </label>

        {% wrap button_tag(attrs().cls("btn btn--reversed center").type("submit")) %}
          {% call image_tag(ctx, "check.svg", attrs().aria_hidden().size(20)) %}
          <span class="for-screen-reader">Save changes</span>
        {% end %}
      </div>
    {% end %}

    <div class="margin-block-start pad-block pad-inline-double fill-shade border-radius">
      {% wrap form_with(settings_form) %}
        <div class="flex-item-grow flex align-center gap txt-align-start">
          {% call image_tag(ctx, "crown.svg", attrs().cls("colorize--black").aria_hidden().size(18)) %} Must be admin to create new rooms
        </div>
        {% call settings_fields.hidden_field("restrict_room_creation_to_administrators", std::nullopt, attrs().value(view.restrict_room_creation_to_administrators ? "false" : "true")) %}

        <label class="switch">
          <input type="checkbox"
                class="switch__input"
                {% if view.restrict_room_creation_to_administrators %}checked{% end %}
                data-action="change->form#submit">
          <span class="switch__btn round"></span>
          <span class="for-screen-reader">
            Must be admin to create new rooms
          </span>
        </label>

      {% end %}
    </div>
  {% else %}
    {% call account_logo_tag(ctx, std::optional<std::string_view>("txt-xx-large center")) %}
    <h1 class="flex-item-grow txt-x-large">{{ ctx.account.name }}</h1>
  {% end %}

  <div class="margin-block pad-inline pad-block-start fill-shade border-radius">
    {% render accounts/invite(ctx, join_url) %}

    <hr class="margin-block separator full-width" style="--border-style: solid">

    <menu class="flex flex-column gap margin-none pad">
      <turbo-frame id="account_users">
        {% for user : view.administrators %}{% render accounts/users/user(ctx, user) %}{% end %}
        {% if !view.administrators.empty() && !view.members.empty() %}
          <hr class="separator full-width" style="--border-style: solid">
        {% end %}

        {% for user : view.members %}{% render accounts/users/user(ctx, user) %}{% end %}        {% if view.next_page %}{% render accounts/users/next_page_container(*view.next_page) %}{% end %}
      </turbo-frame>
    </menu>
  </div>
</section>
