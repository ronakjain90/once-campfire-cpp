{# reference/app/views/messages/_actions.html.erb #}
{% include views/messages/support.hpp %}
{% include views/messages/types.hpp %}
{% params const ViewContext& ctx, const MessageView& message %}
<div class="message__actions" data-controller="soft-keyboard">
  <details class="position-relative" data-controller="popup" data-action="keydown.esc-&gt;popup#close toggle-&gt;popup#toggle click@document-&gt;popup#closeOnClickOutside" data-popup-orientation-top-class="popup-orientation-top">
    <summary class="btn message__action-btn message__options-btn">
      <img class="colorize--black" aria-hidden="true" src="{{ ctx.asset("menu-dots-horizontal.svg") }}" width="20" height="20" />
      <span class="for-screen-reader">Message options</span>
    </summary>

    <div class="message__actions-menu border shadow" data-popup-target="menu">
      <div class="quick-boosts">
        {% for reaction : kReactions %}
          <form data-turbo-frame="{{ message.dom_id("boosting") }}" data-action="popup#close" action="{{ boosts_path(message) }}" accept-charset="UTF-8" method="post">
            <input type="hidden" name="boost[content]" id="boost_content" value="{{ reaction.character }}" />
            <button name="button" type="submit" title="{{ reaction.title }}" class="btn message__action-btn" data-emoji="{{ reaction.character }}">
              <figure class="margin-none boost-character">{{ reaction.character }}</figure>
              <span class="for-screen-reader">{{ reaction.title }}</span>
</button></form>
        {% end %}

        <a class="btn message__action-btn message__boost-btn" data-turbo-frame="{{ message.dom_id("new_boost") }}" data-action="soft-keyboard#open popup#close" href="{{ new_boost_path(message) }}">
          <img class="colorize--black" aria-hidden="true" src="{{ ctx.asset("boost.svg") }}" width="20" height="20" />
          <span class="for-screen-reader">New boost</span>
</a>      </div>

      <div class="flex flex-wrap border-top margin-block-start-half pad-block-start-half message__actions-grid">
        {% if const AttachmentView* attachment = message.attachment() %}
          <a class="btn message__action-btn center full-width hide-in-ios-pwa" title="Download" aria-label="Download" href="{{ attachment->download_path }}">
            <img class="colorize--black" aria-hidden="true" src="{{ ctx.asset("download.svg") }}" width="20" height="20" />
</a>
          <button class="btn message__action-btn center full-width" data-controller="web-share" data-action="web-share#share" data-web-share-files-value="{{ attachment->blob_path }}" data-web-share-title-value="{{ attachment->filename }}" title="Share" aria-label="Share">
            <img class="colorize--black" aria-hidden="true" src="{{ ctx.asset("share.svg") }}" width="20" height="20" />
</button>
        {% else %}
          <button class="btn message__action-btn center full-width" data-action="reply#reply" title="Reply" aria-label="Reply">
            <img class="colorize--black" aria-hidden="true" src="{{ ctx.asset("reply.svg") }}" width="20" height="20" />
</button>
        {% end %}

        <button class="btn message__action-btn center full-width" title="Copy link" aria-label="Copy link" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-url-value="{{ at_path(message) }}">
          <img class="colorize--black" aria-hidden="true" src="{{ ctx.asset("link.svg") }}" width="20" height="20" />
</button>
        <a class="btn message__action-btn center full-width message__edit-btn" data-turbo-frame="{{ message.dom_id("edit") }}" title="Edit" aria-label="Edit" href="{{ edit_path(message) }}">
          <img class="colorize--black" aria-hidden="true" src="{{ ctx.asset("pencil.svg") }}" width="20" height="20" />
</a>      </div>
    </div>
</details></div>
