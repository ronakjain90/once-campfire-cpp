{# reference/app/views/messages/_message.html.erb, with MessagesHelper#message_tag: `cache [ message, "presentation-v3" ]` #}
{% include views/messages/support.hpp %}
{% include views/messages/types.hpp %}
{% include routes/routes.hpp %}
{% params const ViewContext& ctx, const MessageView& message %}
{% cache message_fragment_key(message.id, message.updated_at) %}
{{= SafeHtml::literal("\n") -}}
{% if message.is_unrenderable() %}
  {% render messages/unrenderable() %}
{% else %}
  <div id="{{ message.dom_id() }}" class="message {% if message.all_emoji %}message--emoji{% end %}" data-controller="reply" data-user-id="{{ message.creator.id }}" data-message-id="{{ message.id }}" data-message-timestamp="{{ created_at_epoch(message) }}" data-message-updated-at="{{ updated_at_epoch(message) }}" data-sort-value="{{ created_at_epoch(message) }}" data-messages-target="message" data-search-results-target="message" data-refresh-room-target="message" data-reply-composer-outlet="#composer">
    <h2 class="message__day-separator"><time datetime="{{ created_at_iso(message) }}" data-local-time-target="date"></time></h2>

    <figure class="avatar message__avatar">
      <a title="{{ message.creator.title }}" class="btn avatar" data-turbo-frame="_top" href="{{ routes::user(message.creator.id) }}"><img aria-hidden="true" src="{{ message.creator.avatar_url }}" width="48" height="48" /></a>
    </figure>

    <turbo-frame id="{{ message.dom_id("edit") }}">
      <div class="message__body">
        <div class="message__body-content">
          <div class="message__meta">
            <h3 class="message__heading">
              <span class="message__author" title="{{ message.creator.title }}">
                <strong data-reply-target="author">{{ message.creator.name }}</strong>
              </span>
              <a target="_top" class="message__permalink" href="{{ at_path(message) }}"><time class="message__timestamp" datetime="{{ created_at_iso(message) }}" data-local-time-target="time"></time></a>
              <span class="message__room">
                <a target="_top" data-reply-target="link" href="{{ at_path(message) }}">{{ message.room_name }}</a>
              </span>
            </h3>
            {% render messages/actions(ctx, message) %}
          </div>
          {% render messages/presentation(ctx, message) %}
          {% render messages/boosts/boosts(ctx, message) %}
        </div>
      </div>
    </turbo-frame>
</div>
{% end %}
{% end %}
