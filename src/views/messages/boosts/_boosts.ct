{# reference/app/views/messages/boosts/_boosts.html.erb #}
{% include views/messages/support.hpp %}
{% include views/messages/types.hpp %}
{% params const ViewContext& ctx, const MessageView& message %}
<turbo-frame id="{{ message.dom_id("boosting") }}">
  <div class="boosts flex flex-wrap align-center gap full-width" style="--column-gap: 0.4ch; --row-gap: 0"
      data-controller="turbo-streaming" data-action="turbo:submit-start->turbo-streaming#unsubscribe">
    <div class="flex-inline flex-wrap gap" id="{{ message.dom_id("boosts") }}" data-turbo-streaming-target="container">
      {% for boost : message.boosts %}
      {% render messages/boosts/boost(ctx, boost) %}
      {% end %}
    </div>

    <turbo-frame id="{{ message.dom_id("new_boost") }}">
      <div class="flex-inline message__boost-inline" data-controller="soft-keyboard">
        <a class="boost__action txt-small btn" action="soft-keyboard#open" href="{{ new_boost_path(message) }}">
          <img aria-hidden="true" src="{{ ctx.asset("boost.svg") }}" width="20" height="20" />
          <span class="for-screen-reader">Add a boost</span>
</a>      </div>
</turbo-frame>  </div>
</turbo-frame>