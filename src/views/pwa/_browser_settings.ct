{# reference/app/views/pwa/_browser_settings.html.erb #}
{% include views/helpers/users.hpp %}
{% params const ViewContext& ctx %}
{% if !((ctx.platform.safari || ctx.platform.chrome) && ctx.platform.ios) %}  <details class="notifications-help" data-notifications-target="details">
    <summary class="btn">
      {% call image_tag(ctx, "external/web.svg", attrs().aria_hidden().size(20)) %}
      <strong>Check your {{ capitalize(ctx.platform.browser) }} settings</strong>
      {% call image_tag(ctx, "disclosure.svg", attrs().aria_hidden().size(10).cls("disclosure")) %}
    </summary>

{% if ctx.platform.firefox && ctx.platform.android %}        <ol>
          <li>Tap <em>{% call image_tag(ctx, "lock.svg", attrs().alt("the View site information button").size(20)) %}</em> in the address bar.</li>
          <li>Tap <em>Notification</em> to change to <em>Allowed</em>.</li>
        </ol>
{% elif ctx.platform.edge && ctx.platform.desktop %}        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em>{% call image_tag(ctx, "lock.svg", attrs().alt("the View site information button").size(20)) %}</em> left of the address bar.</li>
          <li>Under <em>Permissions for this site &gt; Notifications</em>, choose <em>Allow</em>.</li>
        </ol>
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {{ capitalize(ctx.platform.browser) }}.</h2>
        <ol>
{% if ctx.platform.windows %}            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em>{% call image_tag(ctx, "external/switch.svg", attrs().alt("the switch").size(22)) %}</em> <em>ON</em> for {{ capitalize(ctx.platform.browser) }}.</li>
{% else %}            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em>{{ capitalize(ctx.platform.browser) }}</em>.</li>
            <li>Click <em>{% call image_tag(ctx, "external/switch.svg", attrs().alt("the switch").size(22)) %}</em> to <em>Allow notifications</em>.</li>
{% end %}        </ol>
{% elif ctx.platform.firefox && ctx.platform.desktop %}        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em>{{ capitalize(ctx.platform.browser) }}</em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click <em>Privacy & Security</em> in the sidebar.</li>
          <li>Scroll down to <em>Permissions</em>.</li>
          <li>Click <em>Settings</em> next to <em>Notifications</em>.</li>
          <li>Select <em>Allow</em> next to <em>{{ ctx.url("/") }}</em>.</li>
        </ol>

        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {{ capitalize(ctx.platform.browser) }}.</h2>
        <ol>
{% if ctx.platform.windows %}            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em>{% call image_tag(ctx, "external/switch.svg", attrs().alt("the toggle button").size(22)) %}</em> <em>ON</em> for {{ capitalize(ctx.platform.browser) }}.</li>
{% else %}            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em>{{ capitalize(ctx.platform.browser) }}</em>.</li>
            <li>Click <em>{% call image_tag(ctx, "external/switch.svg", attrs().alt("the switch").size(22)) %}</em> to <em>Allow notifications</em>.</li>
{% end %}        </ol>
{% elif ctx.platform.chrome && ctx.platform.desktop %}        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click the <em>{% call image_tag(ctx, "external/sliders.svg", attrs().alt("View site information").size(20)) %}</em> icon in the address bar.</li>
          <li>Click <em>Site Settings</em>.</li>
          <li>Ensure notifications are <em>Allowed</em>.</li>
        </ol>

        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {{ capitalize(ctx.platform.browser) }}.</h2>
        <ol>
{% if ctx.platform.windows %}            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em>{% call image_tag(ctx, "external/switch.svg", attrs().alt("the switch").size(22)) %}</em> <em>ON</em> for {{ capitalize(ctx.platform.browser) }}.</li>
{% else %}            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em>{{ capitalize(ctx.platform.browser) }}</em>.</li>
            <li>Click <em>{% call image_tag(ctx, "external/switch.svg", attrs().alt("the switch").size(22)) %}</em> to <em>Allow notifications</em>.</li>
{% end %}        </ol>
{% elif ctx.platform.chrome && ctx.platform.android %}        <ol>
          <li>Tap the <em>{% call image_tag(ctx, "menu-dots-vertical.svg", attrs().alt("More options").size(16)) %}</em> menu button.</li>
          <li>Tap <em>Settings</em>.</li>
          <li>Tap <em>Notifications</em>.</li>
          <li>Tap <em>{% call image_tag(ctx, "external/switch.svg", attrs().alt("the switch").size(22)) %}</em> to <em>Allow {{ capitalize(ctx.platform.browser) }} notifications</em>.</li>
          <li>Tap <em>{% call image_tag(ctx, "external/switch.svg", attrs().alt("the switch").size(22)) %}</em> next to <em>Web apps</em>.</li>
          <li>Tap <em>{% call image_tag(ctx, "notification-bell-alert.svg", attrs().alt("the notification bell").size(16)) %}</em> and select <em>Allow</em>.</li>
        </ol>
{% elif ctx.platform.safari && ctx.platform.desktop %}        <ol>
          <li>Click <em>{{ capitalize(ctx.platform.browser) }}</em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click the <em>Websites</em> tab.</li>
          <li>Click <em>Notifications</em> in the sidebar.</li>
          <li>Click <em>{{ ctx.url("/") }}</em> in the list.</li>
          <li>Select <em>Allow</em>.</li>
        </ol>
{% else %}        <p>Ensure notifications are enabled for <em>{{ ctx.url("/") }}</em> in your web browser settings.</p>
{% end %}  </details>
{% end %}
