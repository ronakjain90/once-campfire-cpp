{# reference/app/views/pwa/_install_instructions.html.erb #}
{% include views/helpers/users.hpp %}
{% params const ViewContext& ctx %}
{% if !(ctx.platform.chrome || (ctx.platform.firefox && !ctx.platform.android)) %}  <details class="notifications-help pwa__instructions hide-in-pwa" data-controller="pwa-install" data-pwa-install-prompting-class="pwa--can-install" data-notifications-target="details">
    <summary class="btn">
      {% call image_tag(ctx, "external/install.svg", attrs().aria_hidden().size(20)) %}
      <strong>Install Campfire as a web app.</strong>
      {% call image_tag(ctx, "disclosure.svg", attrs().aria_hidden().size(10).cls("disclosure")) %}
    </summary>

{% if ctx.platform.edge %}        <ol>
          <li>Click <em>{% call image_tag(ctx, "install-edge.svg", attrs().alt("the app available - install Campfire chat button").size(16)) %}</em>in the address bar.</li>
          <li>Click <em>Install</em>.</li>
        </ol>
{% elif ctx.platform.chrome && ctx.platform.android %}        <ol>
          <li>Tap the <em>{% call image_tag(ctx, "menu-dots-vertical.svg", attrs().alt("More options").size(16)) %}</em> menu button.</li>
          <li>Tap <em>Install app</em> in the menu.</li>
        </ol>
{% elif ctx.platform.firefox && ctx.platform.android %}        <ol>
          <li>Tap the <em>{% call image_tag(ctx, "menu-dots-vertical.svg", attrs().alt("More options").size(16)) %}</em> menu button.</li>
          <li>Tap <em>Install</em> in the menu.</li>
        </ol>
{% elif ctx.platform.safari && ctx.platform.desktop %}        <ol>
          <li>Click <em>File</em> in the top left.</li>
          <li>Click <em>Add to Dock…</em>.</li>
        </ol>
{% elif (ctx.platform.safari || ctx.platform.chrome) && ctx.platform.ios %}        <p>To receive push notifications in {{ capitalize(ctx.platform.browser) }} for {{ ctx.platform.operating_system }}, you must install Campfire as a web app.</p>
        <ol>
          <li>Tap <em>{% call image_tag(ctx, "external/share.svg", attrs().alt("the share button").size(20)) %}</em></li>
          <li>Tap <em>Add to Home Screen</em>.</li>
        </ol>
{% else %}        <p>Some platforms require you to install Campfire as a web app to receive push notifications.</p>
{% end %}{{= SafeHtml::literal("") }}
    <div class="margin-block-start txt-align-center pwa__installer">
      <hr class="separator margin-block">
      <button class="btn btn--reversed center" data-action="pwa-install#promptInstall">
        {% call image_tag(ctx, "external/install.svg", attrs().aria_hidden()) %}
        Install now
      </button>
    </div>
  </details>
{% end %}{{= SafeHtml::literal("") }}
