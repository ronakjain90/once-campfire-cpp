{# reference/app/views/rooms/closeds/_user.html.erb #}
{% include views/rooms/helpers.hpp %}
{% include routes/routes.hpp %}
{% params const ViewContext& ctx, const ClosedFormView& form, const UserSummary& user, bool selected %}
<li class="flex align-center gap margin-none" data-value="{{ lowercase(user.name) }}">
  <figure class="avatar flex-item-no-shrink" style="--avatar-size: 4ch;">
    <a title="{{ user.title }}" class="btn avatar" data-turbo-frame="_top" href="{{ routes::user(user.id) }}"><img aria-hidden="true" loading="lazy" src="{{ user.avatar_path }}" width="48" height="48" /></a>
  </figure>

  <div class="min-width">
    <div class="overflow-ellipsis fill-shade"><strong>{{ user.name }}</strong></div>
  </div>

  <hr class="separator" aria-hidden="true">{% if form.can_administer %}{% if user.id == form.current_user_id && !form.room.id %}
      <input type="hidden" name="user_ids[]" value="{{ user.id }}" />
      <img class="colorize--black flex-item-no-shrink" aria-hidden="true" src="{{ ctx.asset("check.svg") }}" width="20" height="20" />{% else %}
      <label class="switch flex-item-no-shrink">
        <input type="checkbox" name="user_ids[]" value="{{ user.id }}" class="switch__input"{% if selected %} checked="checked"{% end %} />
        <span class="switch__btn round"></span>
        <span class="for-screen-reader">Give {{ user.name }} access to this room</span>
      </label>{% end %}{% end %}
</li>