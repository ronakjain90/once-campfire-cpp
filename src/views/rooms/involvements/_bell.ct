{# reference/app/views/rooms/involvements/_bell.html.erb #}
{% include views/rooms/show.hpp %}
{% include routes/routes.hpp %}
{% params const ViewContext& ctx, const RoomView& room %}
<span>
  <span class="button_to_change_notifying"
      data-controller="notifications" data-notifications-subscriptions-url-value="{{ routes::user_push_subscriptions() }}" data-notifications-attention-class="btn--pulsing">
    <turbo-frame data-controller="turbo-frame" data-action="notifications:ready@window-&gt;turbo-frame#load" data-turbo-frame-url-param="{{ routes::room_involvement(room.id) }}" id="{{ room.dom_id("involvement") }}">
      <button class="btn" data-action="click->notifications#attemptToSubscribe" data-notifications-target="bell">
        <img aria-hidden="true" src="{{ ctx.asset("notification-bell-loading.svg") }}" width="20" height="20" />
        <img aria-hidden="true" hidden="hidden" src="{{ ctx.asset("notification-bell-alert.svg") }}" width="20" height="20" />
        <span class="for-screen-reader">Notification settings for this {{ room.noun() }}</span>
      </button>
</turbo-frame>
    <dialog data-notifications-target="notAllowedNotice" class="dialog pad center center-block border-radius border shadow" style="--inline-space: var(--block-space)">
      <div class="flex flex-column txt-align-center">
        <span class="btn btn--faux center txt-x-large">
          <img aria-hidden="true" src="{{ ctx.asset("notification-bell-alert.svg") }}" width="48" height="48" />
          <span class="for-screen-reader">Notifications alert</span>
        </span>

        <section>
          <h1 class="txt-large margin-none">Notifications aren’t allowed</h1>
          <div class="txt-align-start margin-block-start">
            {% render pwa/browser_settings(ctx) %}
            {% render pwa/system_settings(ctx) %}
            {% render pwa/install_instructions(ctx) %}
          </div>
        </section>

        <form method="dialog" class="flex align-center gap center">
          <button class="btn dialog__close" autofocus="true">
            <span class="for-screen-reader">Close</span>
            <img aria-hidden="true" src="{{ ctx.asset("remove.svg") }}" width="20" height="20" />
          </button>
        </form>
      </div>
    </dialog>
  </span>
</span>
