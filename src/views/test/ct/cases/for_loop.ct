{% include <vector> %}
{% include <optional> %}
{% params std::string_view name, SafeHtml markup, const std::vector<std::string_view>& items, int n, bool flag, std::optional<std::string_view> nothing %}
<ul>
{% for item : items %}
  <li>{{ item }}</li>
{% end %}
</ul>
{% for std::string_view item : items %}<i>{{ item }}</i>{% end %}
