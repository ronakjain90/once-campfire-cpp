{# reference/app/views/users/sidebars/rooms/_direct_placeholder.html.erb #}
{% include views/users/sidebar.hpp %}
{% params const ViewContext& ctx, const UserSummary& user %}
{% wrap button_to(rooms_directs_with_user(user.id), attrs().cls("direct borderless fill-transparent unpad")) %}
  <span class="avatar">
    {% call image_tag(ctx, user.avatar_path, attrs().aria_hidden()) %}
  </span>

  <span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
    <span class="txt-nowrap overflow-ellipsis">
      <span class="for-screen-reader">Start a ping with</span>
      {{ user.first_name() }}
    </span>
  </span>
{% end %}
