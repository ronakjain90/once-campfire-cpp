{
 "area": "A1",
 "source": "a0",
 "scenarios": [
  {
   "name": "sign-in page",
   "seed": "default",
   "steps": [
    {
     "name": "form",
     "path": "/session/new"
    },
    {
     "name": "form with email",
     "path": "/session/new?email_address=david%40example.com%22%3E"
    },
    {
     "name": "form gzip",
     "path": "/session/new",
     "accept_encoding": "gzip"
    },
    {
     "name": "form revisit",
     "path": "/session/new",
     "revisit": true
    },
    {
     "name": "form head",
     "method": "HEAD",
     "path": "/session/new"
    },
    {
     "name": "form json",
     "path": "/session/new",
     "accept": "application/json"
    },
    {
     "name": "form turbo frame",
     "path": "/session/new",
     "headers": {
      "Turbo-Frame": "main"
     }
    },
    {
     "name": "form bad utf8",
     "path": "/session/new?email_address=%FF"
    }
   ]
  },
  {
   "name": "unauthenticated redirect",
   "seed": "default",
   "steps": [
    {
     "name": "root",
     "path": "/"
    },
    {
     "name": "root with query",
     "path": "/?a=1&b=2"
    },
    {
     "name": "root gzip",
     "path": "/",
     "accept_encoding": "gzip"
    },
    {
     "name": "root post",
     "method": "POST",
     "path": "/",
     "headers": {
      "Sec-Fetch-Site": "same-origin"
     }
    }
   ]
  },
  {
   "name": "sign in then out",
   "seed": "default",
   "mutates": true,
   "steps": [
    {
     "op": "login",
