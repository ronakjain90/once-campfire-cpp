    },
    {
     "name": "sign out",
     "actor": "david",
     "method": "DELETE",
     "path": "/session",
     "headers": {
      "Sec-Fetch-Site": "same-origin"
     }
    },
    {
     "name": "form after sign out",
     "actor": "david",
     "path": "/session/new"
    },
    {
     "name": "sign out again",
     "actor": "david",
     "method": "DELETE",
     "path": "/session",
     "headers": {
      "Sec-Fetch-Site": "same-origin"
     }
    }
   ]
  },
